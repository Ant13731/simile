{
    "cSpell.words": [
        "Agda",
        "behaviour",
        "CDOT",
        "Dafny",
        "dedentation",
        "dedents",
        "Forall",
        "honourable",
        "inversable",
        "lambdadef",
        "MAPLET",
        "maplets",
        "POWERSET",
        "Pydantic",
        "RIGHTARROW",
        "satisfiability",
        "SURJECTIVE",
        "typeclass",
        "typeclasses"
    ],
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./implementation",
        "-p",
        "*test.py"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "packages",
        "-vvl",
        "-n",
        "auto"
    ],
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "workbench.colorCustomizations": {
        "editor.background": "#070707",
        "sideBar.background": "#070707",
        "terminal.background": "#070707",
        "menu.background": "#070707",
        "statusBar.background": "#070707",
        "activityBar.background": "#070707",
        "titleBar.background": "#070707",
        "banner.background": "#070707",
    },
    "python.analysis.extraPaths": [
        "packages/simile_compiler",
        "packages/simile_jupyter_extension",
        "packages/simile_jupyter_kernel",
        "~/GitHub/llvm-project/build/tools/mlir/python_packages/mlir_core"
    ],
    "rust-analyzer.linkedProjects": [
        "${workspaceFolder}/packages/simile_compiler/src/mod/codegen/templates/rust/Cargo.toml",
        "${workspaceFolder}/packages/simile_compiler/build/rust/Cargo.toml",
    ],
    "biome.suggestInstallingGlobally": false,
    "[latex]": {
        "editor.formatOnSave": false
    },
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "--shell-escape",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "-auxdir=%AUXDIR%",
                "%DOC%"
            ],
            // "env": {
            //     // Prepends your workspace venv Scripts folder to the system PATH
            //     "PATH": "%WORKSPACE_FOLDER%/.venv/Scripts;%PATH%"
            // }
        },
        {
            "name": "lualatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-lualatex",
                "-outdir=%OUTDIR%",
                "-auxdir=%AUXDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "xelatexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-outdir=%OUTDIR%",
                "-auxdir=%AUXDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk_rconly",
            "command": "latexmk",
            "args": [
                "%DOC%"
            ]
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "--shell-escape",
                "%DOC%"
            ],
            // "env": {
            //     // Prepends your workspace venv Scripts folder to the system PATH
            //     "Path": "%WORKSPACE_FOLDER%/.venv/Scripts;%PATH%"
            // }
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "%DOCFILE%"
            ]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%DOCFILE%"
            ]
        },
        {
            "name": "rnw2tex",
            "command": "Rscript",
            "args": [
                "-e",
                "knitr::opts_knit$set(concordance = TRUE); knitr::knit('%DOCFILE_EXT%')"
            ]
        },
        {
            "name": "jnw2tex",
            "command": "julia",
            "args": [
                "-e",
                "using Weave; weave(\"%DOC_EXT%\", doctype=\"tex\")"
            ]
        },
        {
            "name": "jnw2texminted",
            "command": "julia",
            "args": [
                "-e",
                "using Weave; weave(\"%DOC_EXT%\", doctype=\"texminted\")"
            ]
        },
        {
            "name": "pnw2tex",
            "command": "pweave",
            "args": [
                "-f",
                "tex",
                "%DOC_EXT%"
            ]
        },
        {
            "name": "pnw2texminted",
            "command": "pweave",
            "args": [
                "-f",
                "texminted",
                "%DOC_EXT%"
            ]
        },
        {
            "name": "tectonic",
            "command": "tectonic",
            "args": [
                "--synctex",
                "--keep-logs",
                "--print",
                "%DOC%.tex"
            ]
        }
    ]
}