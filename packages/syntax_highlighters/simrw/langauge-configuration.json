{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "⟨",
            "⟩"
        ],
        [
            "<[",
            "]>"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "⟨",
            "close": "⟩"
        },
        {
            "open": "<[",
            "close": "]>"
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string",
                "comment"
            ]
        }
    ],
    "surroundingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "⟨",
            "⟩"
        ],
        [
            "\"",
            "\""
        ]
    ],
    "onEnterRules": [
        {
            "beforeText": "^\\s*return\\b.*$",
            "action": {
                "indent": "outdent"
            }
        },
        {
            "beforeText": "^.*(?<![:<]):\\s*(#.*)?$",
            "action": {
                "indent": "indent"
            }
        }
    ],
    "folding": {
        "markers": {
            "start": "^\\s*rule\\b",
            "end": "^(?=\\s*rule\\b)|\\s*$"
        }
    },
    "indentationRules": {
        "increaseIndentPattern": "^(.*:)$",
        "decreaseIndentPattern": "^\\s*(rewrite|when|vars)"
    }
}