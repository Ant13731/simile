rule functional_image:
    vars:
        # Note: may fail if R is not total
        R: relation[T1, T2]
        x: T1
    rewrite:
        R(x) ~> choice(R[x])

rule image:
    vars:
        R: relation[T1, T2]
        S: set[T1]
    rewrite:
        R[S] ~> {x |-> y in R .: x in S | y}

rule product:
    vars:
        x: T1
        y: T2
        S: set[T1]
        T: set[T2]
    rewrite:
        x |-> y in S >< T
        ~>
        x in S and y in T

rule product_generator:
    vars:
        x: T1
        y: T2
        S: set[T1]
        T: set[T2]
        P: bool
    rewrite:
        ast_.Generator(x |-> y, S >< T, P)
        ~>
        [ast_.Generator(x, S, True), ast_.Generator(y, T, P)]
    when:
        in_ASTNode("QuantifierBody")
        loop_over_field_and_flatten_output("generators")

rule inverse:
    vars:
        x: T1
        y: T2
        R: relation[T2, T1]
    rewrite:
        x |-> y in R~
        ~>
        y |-> x in R

rule inverse_generator:
    vars:
        x: T1
        y: T2
        R: relation[T2, T1]
        P: bool
    rewrite:
        ast_.Generator(x |-> y, R~, P)
        ~>
        ast_.Generator(y |-> x, R, P)
    when:
        in_ASTNode("QuantifierBody")
        loop_over_field_and_flatten_output("generators")

rule composition:
    vars:
        x: T1
        y: T3
        z1: T2
        z2: T2
        Q: relation[T1, T2]
        R: set[T2, T3]
    rewrite:
        x |-> y in Q <> R
        ~>
        x |-> z1 in Q and z2 |-> y in R and z1 = z2

rule composition_generator:
    vars:
        x: T1
        y: T3
        z1: T2
        z2: T2
        Q: relation[T1, T2]
        R: set[T2, T3]
        P: bool
    rewrite:
        ast_.Generator(x |-> y, Q <> R, P)
        ~>
        [ast_.Generator(x |-> z1, Q, True), ast_.Generator(z2 |-> y, R, z1 = z2 and P)]
        # x |-> z1 in Q and z2 |-> y in R and z1 = z2
    when:
        in_ASTNode("QuantifierBody")
        loop_over_field_and_flatten_output("generators")

rule union:
    vars:
        S: set[T1]
        T: set[T1]
    rewrite:
        S \/ T ~> {(x in S | x) ` (x in T .: x not in S | x)}

rule intersection:
    vars:
        S: set[T1]
        T: set[T1]
    rewrite:
        S /\ T ~> {x in S .: x in T | x}

rule difference:
    vars:
        S: set[T1]
        T: set[T1]
    rewrite:
        S \ T ~> {x in S .: x not in T | x}

rule membership_collapse:
    vars:
        x: T1
        E: T1
        G: list[Generator]
        op: ast_.QuantifierOperator
    rewrite:
        x in ast_.Quantifier3(ast_.QuantifierBody(G, E), op) ~> G and x = E
    when:
        expression_in_comprehension_predicate()
        cast_right_side_term_to_bool(G)
        enum_in_list(op, ["UNION_ALL", "INTERSECTION_ALL", "SET", "RELATION", "SEQUENCE", "BAG"])

rule set_membership:
    vars:
        S: set[T1]
        e: T1
    rewrite:
        e in S ~> exists x in S | e = x
