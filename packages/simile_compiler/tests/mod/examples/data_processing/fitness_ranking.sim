# Helpers/formatters - see FIXME in populate_symbol_table about allowing unordered func defs
procedure start_of_day(seconds_since_epoch: float) -> int:
    return (seconds_since_epoch div 86400) * 86400 # in UTC
procedure start_of_week(seconds_since_epoch: int) -> int:
    return seconds_since_epoch - ((seconds_since_epoch - 259200) mod 604800) # subtract 3 days so our week starts on a Sunday, then mod the num of seconds in a week

procedure extract_daily_key_from_raw(r: FitnessMachineRecord) -> DailyKey:
    return DailyKey(r.key.member, r.key.machine, r.key.gym, start_of_day(r.key.start_time))
procedure extract_blended_key_from_daily(r: FitnessMachineDaily) -> BlendedDailyKey:
    return BlendedDailyKey(r.key.member, r.key.gym, r.key.day)
procedure extract_weekly_key_from_daily(r: BlendedFitnessRankDaily) -> BlendedWeeklyKey:
    return BlendedWeeklyKey(r.key.member, r.key.gym, start_of_week(r.key.day))

procedure group_by_fst(records: relation[K, V]) -> relation[K, set[V]]:
    return {k in dom(records) | k |-> records[{k}]}

procedure merge_raw_to_daily(daily_key: DailyKey, records: set[FitnessMachineRecord]) -> FitnessMachineDaily:
    time_spent: int := sum r in records | r.key.end_time - r.key.start_time
    total_reps: int := sum r in records | r.reps
    total_weight: int := sum r in records | r.weight
    return FitnessMachineDaily(daily_key, time_spent, total_reps, total_weight)
procedure blend_daily(blended_key: BlendedDailyKey, records: set[FitnessMachineDaily]) -> BlendedFitnessRankDaily:
    time_spent: int := sum r in records | r.time_spent
    total_reps: int := sum r in records | r.total_reps
    total_weight: int := sum r in records | r.total_weight
    blended_effort: float := sum r in records | r.total_reps * r.total_weight * r.time_spent
    blended_skill: float := sum r in records | r.total_reps * r.total_weight / r.time_spent
    return BlendedFitnessRankDaily(blended_key, time_spent, total_reps, total_weight, blended_effort, blended_skill)
procedure blend_weekly(blended_key: BlendedWeeklyKey, records: set[BlendedFitnessRankDaily]) -> BlendedFitnessRankWeekly:
    time_spent: int := sum r in records | r.time_spent
    total_reps: int := sum r in records | r.total_reps
    total_weight: int := sum r in records | r.total_weight
    blended_effort: float := sum r in records | r.blended_effort
    blended_skill: float := sum r in records | r.blended_skill
    return BlendedFitnessRankWeekly(blended_key, time_spent, total_reps, total_weight, blended_effort, blended_skill)

# Main data processing functions
procedure raw_to_daily(records: set[FitnessMachineRecord]) -> set[FitnessMachineDaily]:
    # Assume records never cross over day boundaries for the sake of consistency (instead those are already split into two records)
    records_by_merged_key: relation[DailyKey, FitnessMachineRecord] := {r in records | extract_daily_key_from_raw(r) |-> r}
    records_grouped_by_merged_key: relation[DailyKey, set[FitnessMachineRecord]] := group_by_fst(records_by_merged_key)
        trait many_to_one
    merged_records: set[FitnessMachineDaily] := {d |-> rs in records_grouped_by_merged_key | merge_raw_to_daily(d, rs)}
    return merged_records

procedure daily_to_blended_daily(records: set[FitnessMachineDaily]) -> set[BlendedFitnessRankDaily]:
    records_by_merged_key: relation[BlendedDailyKey, FitnessMachineDaily] := {r in records | extract_blended_key_from_daily(r) |-> r}
    records_grouped_by_merged_key: relation[BlendedDailyKey, set[FitnessMachineDaily]] := group_by_fst(records_by_merged_key)
        trait many_to_one
    merged_records: set[BlendedFitnessRankDaily] := {d |-> rs in records_grouped_by_merged_key | blend_daily(d, rs)}
    return merged_records

procedure blended_daily_to_blended_weekly(records: set[BlendedFitnessRankDaily]) -> set[BlendedFitnessRankWeekly]:
    records_by_merged_key: relation[BlendedWeeklyKey, BlendedFitnessRankDaily] := {r in records | extract_weekly_key_from_daily(r) |-> r}
    records_grouped_by_merged_key: relation[BlendedWeeklyKey, set[BlendedFitnessRankDaily]] := group_by_fst(records_by_merged_key)
        trait many_to_one
    merged_records: set[BlendedFitnessRankWeekly] := {d |-> rs in records_grouped_by_merged_key | blend_weekly(d, rs)}
    return merged_records

