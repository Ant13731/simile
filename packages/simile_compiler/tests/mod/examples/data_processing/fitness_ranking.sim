from "../algorithms/merge_sort" import sort_f

K: type := generic
V: type := generic

# Carrier sets
Person: enum := {Kevin, Michael, Adrian, Charlie, Ryan, Steven}
Gym: enum := {Anytime, Goodlife, FitForLess, IronWeight, RockLifter}
Machine: enum := {Treadmill, Bike, BenchPress, Curl, Row, PullUp}
RankingEnum: enum := {time_spent, total_reps, total_weight, blended_effort, blended_skill}

# raw_records: set[FitnessMachineRecord]
# daily_records: set[FitnessMachineDaily]
# daily_rankable_records: set[BlendedFitnessRankDaily]
# weekly_rankable_records: set[BlendedFitnessRankWeekly]

# Relationships
members: relation[Person, Gym] := {} # person is a member of at most one gym
    trait many_to_one
    # trait partial
trainers: relation[Person, Person] := {} # one trainer can be assigned to multiple people, but each person should only have one trainer
    trait many_to_one
employees: relation[Person, Gym] := {} # person is an employee at a Gym
    trait many_to_one
    # trait partial
managers: relation[Person, Person] := {} # person manages employees
    trait many_to_one
    # trait partial
machines_available: relation[Gym, Machine] := {} # gyms can have many machines, machines are not unique so they can exist in multiple gyms
baseline_reps_per_minute: relation[Machine, int] := {} # lowest number of reps needed to qualify for leaderboards on a specific machine
    trait many_to_one
    trait total

# Record types
# Keys (unique identifiers) for below record types
record FitnessMachineRecordKey:
    member: Person # person who did the exercise
    machine: Machine # exercise machine type
    gym: Gym # gym the exercise was done at
    start_time: float # time we started using the machine
    end_time: float # time we ended using the machine

record DailyKey:
    member: Person # person who did the exercise
    machine: Machine # exercise machine type
    gym: Gym # gym the exercise was done at
    day: int # seconds since epoch snapped to the start of the day (UTC)

record BlendedDailyKey:
    member: Person # person who did the exercise
    gym: Gym # gym the exercise was done at
    day: int # seconds since epoch snapped to the start of the day

record BlendedWeeklyKey:
    member: Person # person who did the exercise
    gym: Gym # gym the exercise was done at
    week_start: int # seconds since epoch snapped to the start of the week (Sunday, UTC)

# Basic record as a measure of effort
record FitnessMachineRecord:
    key: FitnessMachineRecordKey
    # Effort data
    reps: int # reps per set * number of sets
    weight: int # weight in lbs
    # Metadata
    # with_trainer: Person | None # the trainer, if the person had a trainer while using the machine
    # TODO this should be a relation, no explicit concept of None

record FitnessMachineDaily:
    key: DailyKey
    # Effort data
    time_spent: int # seconds
    total_reps: int
    total_weight: int
    # then we judge effort based on total_reps * total_weight * time_spent
    # then we judge skill based on total_reps * total_weight / time_spent

record BlendedFitnessRankDaily:
    key: BlendedDailyKey
    # Effort data
    time_spent: int # seconds
    total_reps: int
    total_weight: int
    blended_effort: float # combine records across machines into one value per person
    blended_skill: float

record BlendedFitnessRankWeekly:
    key: BlendedWeeklyKey
    # Effort data
    time_spent: int # seconds
    total_reps: int
    total_weight: int
    blended_effort: float # combine records across machines into one value per person
    blended_skill: float


# Queries
procedure get_value(r: BlendedFitnessRankWeekly, order_by: RankingEnum) -> float:
    if order_by = time_spent:
        return r.time_spent
    # TODO these paths should fail type checking, but i dont think we go through all return statements...
    if order_by = total_reps:
        return r.total_reps
    if order_by = total_weight:
        return r.total_weight
    if order_by = blended_effort:
        return r.blended_effort
    if order_by = blended_skill:
        return r.blended_skill
    # Not possible to reach this state?

procedure get_leaderboard(records: set[BlendedFitnessRankWeekly], order_by: RankingEnum) -> sequence[Person]:
    # from largest to lowest
    # TODO fix workaround while we dont have a sort_by defined. this is very hacky and probably incorrect
    ranked_values: sequence[float] := sort_f([r in records | -get_value(r, order_by)])
    sorted_records: sequence[BlendedFitnessRankWeekly] := [(_, v) in ranked_values, r in records .: get_value(r, order_by) = -v | r]
    # sorted_records: sequence[BlendedFitnessRankWeekly] := sort_f(records, lambda r: BlendedFitnessRankWeekly | -get_value(r, order_by))
    return [_, r in sorted_records | r.key.member]

# procedure get_leaderboard_amount_improved(this_week: set[BlendedFitnessRankWeekly], last_week: set[BlendedFitnessRankWeekly], order_by: RankingEnum) -> sequence[Person]:
