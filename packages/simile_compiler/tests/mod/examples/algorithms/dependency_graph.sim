record Package:
    id: int
    version: int

dependencies: relation[Package, Package] := {}
    trait one_to_many

procedure dependencies_conflict(pkg1: Package, pkg2: Package) -> bool:
    if pkg1.id = pkg2.id:
        return pkg1.version = pkg2.version

    return forall dep1 |-> dep2 in dependencies[{pkg1}] >< dependencies[{pkg2}] | dependencies_conflict(dep1, dep2)